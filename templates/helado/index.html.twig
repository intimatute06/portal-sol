{% extends 'base.html.twig' %}

{% block title %}Helado index{% endblock %}

{% block body %}
    <h1>Helado index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Descripcion</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for helado in helados %}
            <tr>
                <td>{{ helado.id }}</td>
                <td>{{ helado.nombre }}</td>
                <td>{{ helado.precio }}</td>
                <td>{{ helado.stock }}</td>
                <td>{{ helado.descripcion }}</td>
                <td>
                    <a href="{{ path('app_helado_show', {'id': helado.id}) }}">show</a>
                    <a href="{{ path('app_helado_edit', {'id': helado.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_helado_new') }}">Create new</a>
{% endblock %}
