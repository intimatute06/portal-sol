<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Iniciar sesión</title>
    <meta name="description" content="Página de inicio de sesión">
    <link href="{{ asset('css/intro.css') }}" rel="stylesheet" />
</head>
<body>
    <section id="main-page">
        <main>
            <h1>Iniciar sesión</h1>
            {% if error %}
            <p class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}
            <form class="main-container" method="post" action="{{ path('app_login')}}">
                <label for="email">Ingrese su correo electrónico:</label>
                <input type="email" id="email" name="_username" value="{{ last_username }}" required autofocus>
                <label for="pwd">Contraseña:</label>
                <input type="password" id="pwd" name="_password" required>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate')}}">
                <button type="submit">Iniciar sesión</button>
            </form>
        </main>

        <footer>
            <nav class="bottom-nav">
                <ul>
                    <li><a href="#">Home</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </nav>
        </footer>
    </section>
</body>
</html>